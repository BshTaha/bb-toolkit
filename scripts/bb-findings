#!/usr/bin/env python3
"""bb-findings [program] [--min low] [--cls xss] [--open] — review the night's haul."""
import os, sys, json, glob, argparse, textwrap
BB=os.environ.get("BB", os.path.expanduser("~/bugbounty")); TARGETS=os.environ.get("TARGETS",f"{BB}/targets")
RANK={"critical":4,"high":3,"medium":2,"low":1,"info":0}
C={"critical":"\033[1;91m","high":"\033[1;33m","medium":"\033[1;93m","low":"\033[1;94m","info":"\033[0;90m"}
R="\033[0m"; DIM="\033[2m"
a=argparse.ArgumentParser(); a.add_argument("program",nargs="?"); a.add_argument("--min",default="low")
a.add_argument("--cls",default=""); a.add_argument("--full",action="store_true"); a=a.parse_args()
progs=[a.program] if a.program else [os.path.basename(os.path.dirname(p)) for p in glob.glob(f"{TARGETS}/*/state/findings.jsonl")]
if not progs: sys.exit("no findings yet")
for prog in progs:
    p=f"{TARGETS}/{prog}/state/findings.jsonl"
    if not os.path.exists(p): continue
    fs=[]
    for l in open(p,errors="ignore"):
        try: fs.append(json.loads(l))
        except Exception: pass
    fs=[f for f in fs if RANK.get(f.get("severity"),0)>=RANK.get(a.min,1)]
    if a.cls: fs=[f for f in fs if a.cls in f.get("cls","")]
    fs.sort(key=lambda x:(-RANK.get(x.get("severity"),0),x.get("cls","")))
    t={}
    for f in fs: t[f["severity"]]=t.get(f["severity"],0)+1
    print(f"\n\033[1m══ {prog} ══{R}  "+"  ".join(f"{C[s]}{s} {t[s]}{R}" for s in ("critical","high","medium","low") if t.get(s)))
    for f in fs:
        s=f.get("severity","info")
        print(f"\n {C.get(s,'')}[{s.upper()}]{R} {f.get('title','')}  {DIM}({f.get('cls')} · {f.get('confidence')} · {f.get('source')}){R}")
        print(f"   {DIM}→{R} {f.get('target','')[:160]}")
        if a.full:
            for label,key in (("evidence","evidence"),("repro","repro")):
                v=(f.get(key) or "").strip()
                if v: print(textwrap.indent(f"{DIM}{label}:{R} "+v[:600],"   "))
    print(f"\n{DIM} {len(fs)} shown · raw: {p}{R}")
