#!/usr/bin/env python3
"""bb-keys — manage and validate subfinder/uncover API keys.

  bb-keys list            what's filled, what's empty, ranked by value
  bb-keys links [tier]    signup URLs + free-tier notes  (tier: 1|2|3|all)
  bb-keys set <p> <key>   add a key (mirrors into uncover where shared)
  bb-keys test [p]        live-validate keys against real queries
  bb-keys rm <p>          remove a key
"""
import os, sys, re, subprocess, shutil

BB = os.environ.get("BB", os.path.expanduser("~/bugbounty"))
CFG = f"{BB}/data/configs/tools/subfinder/provider-config.yaml"
UNCOVER = f"{BB}/data/configs/tools/uncover/provider-config.yaml"
# providers uncover also understands -> keep both files in sync
SHARED = {"shodan", "censys", "fofa", "quake", "zoomeyeapi", "netlas", "criminalip",
          "publicwww", "hunter", "odin", "binaryedge"}

# tier, provider, free-tier note, signup URL, key format
PROVIDERS = [
 (1,"chaos","FREE w/ ProjectDiscovery account. Purpose-built bug-bounty subdomain dataset — single highest-value key here.","https://cloud.projectdiscovery.io","token"),
 (1,"github","FREE. Classic PAT, NO scopes needed. Mines subdomains out of public code//issues. Add 2-3 tokens comma-separated to dodge rate limits.","https://github.com/settings/tokens","token[,token2]"),
 (1,"virustotal","FREE 500 lookups/day. Excellent passive DNS.","https://www.virustotal.com/gui/my-apikey","token"),
 (1,"securitytrails","FREE 50 queries/mo. Small quota, very high quality historical DNS.","https://securitytrails.com/app/account/credentials","token"),
 (1,"shodan","FREE tier limited; $49 lifetime often on sale. Also powers uncover.","https://account.shodan.io","token"),
 (2,"censys","FREE 250 queries/mo. Cert-based discovery.","https://search.censys.io/account/api","APP_ID:SECRET"),
 (2,"fullhunt","FREE tier, generous. Attack-surface DB.","https://fullhunt.io/user/settings","token"),
 (2,"leakix","FREE. Good for exposed services + subs.","https://leakix.net/settings/api","token"),
 (2,"netlas","FREE tier. Internet-wide scan data.","https://app.netlas.io/profile","token"),
