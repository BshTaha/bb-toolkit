#!/usr/bin/env bash
# bb-secrets <program> — download JS files and grep them for secrets/endpoints
set -uo pipefail
. "$(dirname "${BASH_SOURCE[0]}")/lib/bb-common.sh"
P="${1:?usage: bb-secrets <program>}"; D="${TARGETS:?source ~/bugbounty/env.sh first}/$P"
[ -s "$D/urls/js.txt" ] || { echo "!! run bb-urls first"; exit 1; }
need curl md5sum || exit 1
# Source the program's request policy so JS fetches carry the mandated UA/header
# whether this runs standalone or under bb-hunt (which now also exports BB_UA).
load_profile "$P"
J="$D/urls/jsfiles"; mkdir -p "$J" "$D/loot"; cd "$J" || { echo "!! cannot cd $J"; exit 1; }

Q=$(printf '\042')   # "
A=$(printf '\047')   # '
QUOTE="[${Q}${A}]"

echo "[1/3] downloading $(wc -l < "$D/urls/js.txt") JS files"
# The old loop ran the fetch under `sh -c` with a bash-only ${@:3} array slice.
# /bin/sh is dash here, so every invocation died with "Bad substitution" BEFORE
# curl ran — no JS was ever downloaded and the mandatory header never went out,
# yet the script reported success. Run the fetch under bash and pass the UA /
# headers through the environment instead of positional slicing.
export BB_CURL_UA="${BB_UA:-bugbounty-recon}"
export BB_CURL_H1="${BB_HEADER:-}"
export BB_CURL_H2="${BB_HEADER2:-}"
# NOTE: pass the URL positionally via `-n 1` (each line becomes $1), NOT via
# `-I@`. An -I replacement token is substituted EVERYWHERE in the command,
# including inside the script's own "${args[@]}" — turning [@] into [<url>] and
# crashing with an arithmetic-index error. -n 1 has no placeholder to collide.
xargs -a "$D/urls/js.txt" -P 15 -n 1 bash -c '
  url="$1"
  out="$(printf %s "$url" | md5sum | cut -c1-12).js"
  args=(-s --max-time 15 -A "$BB_CURL_UA")
  [ -n "$BB_CURL_H1" ] && args+=(-H "$BB_CURL_H1")
  [ -n "$BB_CURL_H2" ] && args+=(-H "$BB_CURL_H2")
  curl "${args[@]}" "$url" -o "$out"
' bb-fetch

# Fail loudly instead of silently greppng an empty directory.
if [ -z "$(ls -A "$J" 2>/dev/null)" ]; then
  echo "!! no JS downloaded — check network / headers. Aborting secret scan." >&2
  exit 1
fi

echo "[2/3] secret patterns"
grep -rhoE "(api[_-]?key|apikey|secret|token|passwd|password|authorization|bearer|aws_access_key_id)${QUOTE}?[[:space:]]*[:=][[:space:]]*${QUOTE}[^${Q}${A}]{8,}" . 2>/dev/null \
  | sort -u > "$D/loot/js_secrets.txt"
# high-confidence standalone tokens
grep -rhoE "(AKIA[0-9A-Z]{16}|AIza[0-9A-Za-z_-]{35}|sk_live_[0-9a-zA-Z]{24,}|ghp_[0-9a-zA-Z]{36}|xox[baprs]-[0-9a-zA-Z-]{10,})" . 2>/dev/null \
  | sort -u >> "$D/loot/js_secrets.txt"
# cloud storage / firebase references
grep -rhoE "[a-z0-9.-]+\.(s3[.-][a-z0-9-]*\.?amazonaws\.com|firebaseio\.com|blob\.core\.windows\.net)" . 2>/dev/null \
  | sort -u > "$D/loot/js_cloud_refs.txt"

echo "[3/3] endpoints"
grep -rhoE "${QUOTE}(/[a-zA-Z0-9_?&=/.-]{3,})${QUOTE}" . 2>/dev/null \
  | tr -d "${Q}${A}" | sort -u > "$D/urls/js_endpoints.txt"

sort -u "$D/loot/js_secrets.txt" -o "$D/loot/js_secrets.txt"
wc -l "$D/loot/js_secrets.txt" "$D/loot/js_cloud_refs.txt" "$D/urls/js_endpoints.txt" 2>/dev/null | sed 's/^/    /'
echo "[done] review $D/loot/js_secrets.txt by hand — most hits are false positives"
