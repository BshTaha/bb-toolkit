#!/usr/bin/env bash
# bb-scan <program> [severity]  — nuclei against live hosts. Respect program rate limits!
set -uo pipefail
[ $# -lt 1 ] && { echo "usage: bb-scan <program> [low,medium,high,critical]"; exit 1; }
P="$1"; SEV="${2:-low,medium,high,critical}"
D="${TARGETS}/$P"; S="$D/scans"; mkdir -p "$S"
[ -s "$D/recon/live.txt" ] || { echo "!! run bb-recon first"; exit 1; }
TS=$(date +%F_%H%M)
echo "[*] nuclei -severity $SEV on $(wc -l < "$D/recon/live.txt") hosts (rate-limited to 100/s)"
nuclei -l "$D/recon/live.txt" -t "$NUCLEI_TEMPLATES" -severity "$SEV" \
  -rl 100 -c 25 -timeout 8 -retries 1 -stats -si 60 \
  -eid ssl-issuer,tech-detect,waf-detect \
  -o "$S/nuclei_${TS}.txt"
echo "[done] $S/nuclei_${TS}.txt"
grep -c . "$S/nuclei_${TS}.txt" 2>/dev/null | xargs echo "    hits:"
