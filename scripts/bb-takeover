#!/usr/bin/env bash
# bb-takeover <program> — subdomain takeover checks, under the program's policy.
#
# subzy fetches each host to match service fingerprints but exposes NO rate/UA/
# header flags, so on a program that mandates an identifying UA or header it can
# only send UNMARKED traffic (a policy breach). In that case it is skipped and we
# rely on the profile-driven nuclei takeover templates plus bb-verify's takeover
# check. nuclei's rate/UA/header come from scope/profile.env, not a hardcode.
set -uo pipefail
. "$(dirname "${BASH_SOURCE[0]}")/lib/bb-common.sh"
P="${1:?usage: bb-takeover <program>}"; D="${TARGETS:?source ~/bugbounty/env.sh first}/$P"
[ -s "$D/recon/subdomains.txt" ] || { echo "!! run bb-recon first"; exit 1; }
need nuclei || exit 1
mkdir -p "$D/scans"

load_profile "$P"
if [ "$PROFILE_FOUND" = 1 ]; then
  echo "[profile] rate=${RATE}/s threads=${THREADS} headers=${#UA_ARGS[@]}"
else
  echo "[warn] no scope/profile.env — using conservative defaults. Consider: bb-profile $P init"
fi

if ! command -v subzy >/dev/null 2>&1; then
  echo "[1/2] subzy not installed — skipping"
elif profile_mandates_identity; then
  echo "[1/2] subzy SKIPPED — this program mandates an identifying UA/header that subzy cannot send."
  echo "      covering takeovers via nuclei templates + 'bb-verify $P --checks takeover' instead."
else
  echo "[1/2] subzy (concurrency=${THREADS}; note: subzy has no precise rate limit)"
  subzy run --targets "$D/recon/subdomains.txt" --concurrency "$THREADS" --hide_fails 2>&1 \
    | tee "$D/scans/takeover_subzy.txt"
fi

echo "[2/2] nuclei takeover templates"
nuclei "${UA_ARGS[@]}" -l "$D/recon/subdomains.txt" -t "$NUCLEI_TEMPLATES/http/takeovers/" \
  -rl "$RATE" -c "$THREADS" -silent -o "$D/scans/takeover_nuclei.txt"
echo "[done] $D/scans/"
